## 4. End-to-End Functional Implementation

The following is a production-grade implementation of the core orchestrator. It demonstrates **Pydantic schema validation, tool definitions, Gemini multi-agent execution, adversarial verification, and HITL state dispatching**.

### 4.1. Core Schema and Agent Pipeline (`sentinel_orchestrator.py`)

```python
"""
AuraMed Sentinel - Production Orchestrator
Core multi-agent coordination with structured outputs, deterministic tool execution,
adversarial safety gating, and human-in-the-loop control.
"""

from typing import List, Optional, Dict, Any
from enum import Enum
import json
from pydantic import BaseModel, Field
from google import genai
from google.genai import types

# =====================================================================
# 1. Structured Data Schemas (FHIR-Aligned Pydantic Models)
# =====================================================================

class SeverityLevel(str, Enum):
    LOW = "LOW"
    MODERATE = "MODERATE"
    HIGH = "HIGH"
    CRITICAL = "CRITICAL"

class PatientVitals(BaseModel):
    heart_rate: int = Field(description="Heart rate in beats per minute")
    systolic_bp: int = Field(description="Systolic blood pressure in mmHg")
    diastolic_bp: int = Field(description="Diastolic blood pressure in mmHg")
    respiratory_rate: int = Field(description="Breaths per minute")
    temperature_celsius: float = Field(description="Core temperature in Celsius")
    serum_creatinine: float = Field(description="Serum creatinine in mg/dL")
    estimated_gfr: float = Field(description="Estimated Glomerular Filtration Rate mL/min/1.73m2")

class MedicationOrder(BaseModel):
    drug_name: str
    dose_mg: float
    route: str
    frequency: str

class ClinicalAssessment(BaseModel):
    suspected_conditions: List[str]
    deterioration_risk_score: float = Field(ge=0.0, le=1.0, description="0.0 to 1.0 risk")
    clinical_justification: str
    recommended_interventions: List[str]
    proposed_medications: List[MedicationOrder]

class AuditVerdict(BaseModel):
    passed_safety_checks: bool
    detected_contraindications: List[str]
    renal_clearance_violation: bool
    black_box_warning_flagged: bool
    audit_explanation: str
    requires_human_override: bool

# =====================================================================
# 2. Deterministic Tool Implementation (Pharmacology & Telemetry Engine)
# =====================================================================

def query_fda_drug_contraindications(drug_a: str, drug_b: str) -> Dict[str, Any]:
    """
    Mock integration with RxNorm / National Library of Medicine API.
    Provides deterministic interaction data between proposed and active medications.
    """
    # Deterministic pharmacological rule registry
    critical_interactions = {
        ("ciprofloxacin", "theophylline"): "Severe risk of theophylline toxicity via CYP1A2 inhibition.",
        ("lisinopril", "spironolactone"): "High risk of life-threatening hyperkalemia, especially with renal impairment.",
        ("warfarin", "amiodarone"): "Significant increase in INR; potentiation of anticoagulant effect.",
        ("vancomycin", "gentamicin"): "Synergistic nephrotoxicity and ototoxicity risk."
    }
    
    pair_1 = (drug_a.lower().strip(), drug_b.lower().strip())
    pair_2 = (drug_b.lower().strip(), drug_a.lower().strip())
    
    if pair_1 in critical_interactions:
        return {"status": "CONTRAINDICATED", "interaction_detail": critical_interactions[pair_1]}
    if pair_2 in critical_interactions:
        return {"status": "CONTRAINDICATED", "interaction_detail": critical_interactions[pair_2]}
        
    return {"status": "CLEAR", "interaction_detail": "No severe interaction indexed in active registry."}

def calculate_creatinine_clearance(age: int, weight_kg: float, serum_cr: float, is_female: bool) -> float:
    """Calculates Cockcroft-Gault CrCl for renal dosage adjustment."""
    if serum_cr <= 0:
        return 120.0
    cr_cl = ((140 - age) * weight_kg) / (72 * serum_cr)
    if is_female:
        cr_cl *= 0.85
    return round(cr_cl, 2)

# Map tools for the Gemini Function Calling schema
tools_definition = [
    types.Tool(function_declarations=[
        types.FunctionDeclaration(
            name="query_fda_drug_contraindications",
            description="Check known contraindications and drug-drug interactions between two medications.",
            parameters=types.Schema(
                type=types.Type.OBJECT,
                properties={
                    "drug_a": types.Schema(type=types.Type.STRING, description="First medication name"),
                    "drug_b": types.Schema(type=types.Type.STRING, description="Second medication name")
                },
                required=["drug_a", "drug_b"]
            )
        ),
        types.FunctionDeclaration(
            name="calculate_creatinine_clearance",
            description="Computes patient creatinine clearance (CrCl) using the Cockcroft-Gault equation.",
            parameters=types.Schema(
                type=types.Type.OBJECT,
                properties={
                    "age": types.Schema(type=types.Type.INTEGER, description="Patient age in years"),
                    "weight_kg": types.Schema(type=types.Type.NUMBER, description="Patient weight in kg"),
                    "serum_cr": types.Schema(type=types.Type.NUMBER, description="Serum creatinine in mg/dL"),
                    "is_female": types.Schema(type=types.Type.BOOLEAN, description="True if biologically female")
                },
                required=["age", "weight_kg", "serum_cr", "is_female"]
            )
        )
    ])
]

# =====================================================================
# 3. Sentinel Orchestrator Class
# =====================================================================

class AuraMedOrchestrator:
    def __init__(self, project_id: str, location: str = "us-central1"):
        # Initialize Google GenAI client
        self.client = genai.Client(vertexai=True, project=project_id, location=location)
        self.pro_model = "gemini-2.5-pro"
        self.flash_model = "gemini-2.5-flash"

    def execute_clinical_triage(
        self,
        unstructured_note: str,
        vitals: PatientVitals,
        active_medications: List[str],
        patient_metadata: Dict[str, Any]
    ) -> Dict[str, Any]:
        """
        Orchestrates the entire multi-agent cycle:
        Synthesis -> Tool Calling -> Adversarial Audit -> HITL Dispatch
        """
        print("\n[Stage 1] Synthesizing Clinical Trajectory with Gemini Pro...")
        
        system_instruction_synthesizer = (
            "You are the AuraMed Lead Diagnostic Agent. Synthesize real-time vitals, unstructured doctor "
            "progress notes, and active medications. Use available tools to check drug interactions or renal clearance. "
            "You must output your findings strictly formatted according to the ClinicalAssessment schema."
        )

        prompt_content = f"""
        PATIENT METADATA:
        Age: {patient_metadata.get('age')}, Gender: {patient_metadata.get('gender')}, Weight: {patient_metadata.get('weight_kg')} kg
        
        VITALS & LABS:
        {vitals.model_dump_json(indent=2)}
        
        ACTIVE MEDICATIONS:
        {json.dumps(active_medications)}
        
        UNSTRUCTURED PROGRESS NOTE:
        "{unstructured_note}"
        """

        # Step 1: Synthesizer agent reasons and calls tools
        response = self.client.models.generate_content(
            model=self.pro_model,
            contents=prompt_content,
            config=types.GenerateContentConfig(
                system_instruction=system_instruction_synthesizer,
                tools=tools_definition,
                temperature=0.2
            )
        )

        # Handle tool calls if requested by the model
        if response.function_calls:
            function_responses = []
            for call in response.function_calls:
                call_name = call.name
                call_args = call.args
                print(f"  -> Agent invoked tool: {call_name}({call_args})")
                
                if call_name == "query_fda_drug_contraindications":
                    tool_result = query_fda_drug_contraindications(**call_args)
                elif call_name == "calculate_creatinine_clearance":
                    tool_result = calculate_creatinine_clearance(**call_args)
                else:
                    tool_result = {"error": "Unknown tool"}

                function_responses.append(
                    types.Part.from_function_response(
                        name=call_name,
                        response={"result": tool_result}
                    )
                )

            # Send tool execution results back to model for final synthesis
            response = self.client.models.generate_content(
                model=self.pro_model,
                contents=[
                    types.Part.from_text(prompt_content),
                    response.candidates[0].content.parts[0],
                    *function_responses
                ],
                config=types.GenerateContentConfig(
                    response_mime_type="application/json",
                    response_schema=ClinicalAssessment,
                    temperature=0.1
                )
            )

        candidate_assessment_json = json.loads(response.text)
        candidate_assessment = ClinicalAssessment(**candidate_assessment_json)
        print(f"  -> Candidate Interventions Proposed: {candidate_assessment.recommended_interventions}")

        # =====================================================================
        # Step 2: Adversarial Safety & Pharmacovigilance Auditor Agent
        # =====================================================================
        print("\n[Stage 2] Executing Adversarial Counterfactual Safety Audit...")

        auditor_instruction = (
            "You are the AuraMed Adversarial Safety Agent. Your objective is to proactively invalidate "
            "the proposed medical plan. Look for drug-drug interactions, renal contraindications (CrCl/eGFR), "
            "allergy conflicts, or excessive dosage. Reject any plan that risks patient stability."
        )

        auditor_prompt = f"""
        PATIENT PROFILE:
        Age: {patient_metadata.get('age')}, Weight: {patient_metadata.get('weight_kg')} kg, eGFR: {vitals.estimated_gfr} mL/min
        ACTIVE REGIMEN: {json.dumps(active_medications)}
        
        PROPOSED ASSESSMENT & INTERVENTIONS:
        {candidate_assessment.model_dump_json(indent=2)}
        
        Evaluate this strictly and output an AuditVerdict.
        """

        audit_response = self.client.models.generate_content(
            model=self.flash_model,
            contents=auditor_prompt,
            config=types.GenerateContentConfig(
                system_instruction=auditor_instruction,
                response_mime_type="application/json",
                response_schema=AuditVerdict,
                temperature=0.0  # Deterministic safety gate
            )
        )

        audit_verdict = AuditVerdict(**json.loads(audit_response.text))
        print(f"  -> Audit Passed: {audit_verdict.passed_safety_checks}")
        print(f"  -> Detected Risks: {audit_verdict.detected_contraindications}")

        # =====================================================================
        # Step 3: Human-in-the-Loop Routing & Execution Gate
        # =====================================================================
        print("\n[Stage 3] Human-in-the-Loop Gating & Dispatch...")
        
        dispatch_packet = {
            "patient_id": patient_metadata.get("patient_id"),
            "clinical_assessment": candidate_assessment.model_dump(),
            "safety_audit": audit_verdict.model_dump(),
            "dispatch_status": "PENDING_PHYSICIAN_SIGNATURE" if audit_verdict.passed_safety_checks else "QUARANTINED_BLOCKED",
            "audit_trail_hash": hash(response.text + audit_response.text)
        }

        if not audit_verdict.passed_safety_checks:
            print("  [!] SAFETY VIOLATION DETECTED: Order quarantined. Alert dispatched to Attending Physician.")
        else:
            print("  [+] Safety checks cleared. Clinical decision support card queued for Physician approval.")

        return dispatch_packet


